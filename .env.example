# Copia este archivo como `.env` y ajusta los valores si es necesario.
# «¿Lo quiero?» funciona con los valores por defecto sin necesidad de .env.

# Clave secreta de Django. Sustitúyela por una cadena larga y aleatoria.
SECRET_KEY=reemplaza-con-una-clave-larga-y-aleatoria

# Modo desarrollo. Deja en False solo si sabes lo que haces.
DEBUG=True

# Hosts permitidos, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
